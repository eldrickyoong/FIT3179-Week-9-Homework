{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 300,
  "title": "Population of Malaysia by State (2025)",
  "projection": {"type": "mercator"},
  "data": {
    "url": "data/gadm41_MYS_1.topojson",
    "format": {"type": "topojson", "feature": "gadm41_MYS_1"}
  },
  "transform": [
    {
      "lookup": "properties.NAME_1",
      "from": {
        "data": {
          "url": "data/population_state_simple.csv"
        },
        "key": "state",
        "fields": ["population"]
      }
    }
  ],
  "mark": {"type": "geoshape"},
  "encoding": {
    "color": {
      "title": "Population ('000)",
      "field": "population",
      "type": "quantitative",
      "scale": {
        "type": "linear",
        "scheme": {"name": "lighttealblue"}
      }
    },
    "tooltip": [
      {"field": "properties.NAME_1", "type": "nominal", "title": "State"},
      {"field": "population", "type": "quantitative", "title": "Population ('000)"}
    ]
  }
}