{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 500,
  "title": "Population of Malaysia by State (2025)",
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {"type": "geoshape", "fill": "#eef6ff", "stroke": null}
    },

    {
      "data": {"graticule": {"step": [5, 5]}},
      "mark": {"type": "geoshape", "fill": null, "stroke": "#bdbdbd", "strokeWidth": 0.5}
    },

    {
      "data": {
        "url": "data/gadm41_MYS_1.topojson",
        "format": {"type": "topojson", "feature": "gadm41_MYS_1"}
      },
      "transform": [
        {
          "lookup": "properties.NAME_1",
          "from": {
            "data": {"url": "data/population_state_simple.csv", "format": {"type": "csv"}},
            "key": "state",
            "fields": ["population"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.5},
      "encoding": {
        "color": {
          "field": "population",
          "type": "quantitative",
          "title": "Population (2025)",
          "scale": {"scheme": "viridis", "type": "log", "clamp": true},
          "legend": {"format": "~s"}
        },
        "tooltip": [
          {"field": "properties.NAME_1", "type": "nominal", "title": "State"},
          {"field": "population", "type": "quantitative", "format": ",d", "title": "Population (2025)"}
        ]
      }
    }
  ]
}
